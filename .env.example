# --- Easiest option (local) ---
# Run "Set up admin" on /admin/login (dev only), or npm run setup-admin
# Then restart npm run dev and sign in with ADMIN_PASSWORD.

ADMIN_PASSWORD=
CMS_SECRET=

# --- Vercel (optional) ---
# Set CMS_SECRET (16+) in the Vercel project env if you want /admin/login to work.
# Content edits still must be done locally and pushed via Git — Vercel disk is read-only.
# Do not put ADMIN_PASSWORD in git; add it only in the Vercel dashboard if needed.

# Optional legacy / production fields (setup scripts fill these too)
ADMIN_PASSWORD_BCRYPT=
ADMIN_LOGIN_PLAIN=

# Optional: override where JSON content lives (default: ./data)
# DATA_DIR=

# Optional: where extracted SCORM packages live (default: ./scorm-packages)
# SCORM_PACKAGES_PATH=

# Contact form (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=
# SMTP_FROM=
