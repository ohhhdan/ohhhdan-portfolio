# Local admin (required for /admin)
# Run "Set up admin" on /admin/login, or: npm run setup-admin
# Then restart npm run dev and sign in with ADMIN_PASSWORD.

ADMIN_PASSWORD=
CMS_SECRET=

# Optional legacy fields (setup scripts may fill these)
ADMIN_PASSWORD_BCRYPT=
ADMIN_LOGIN_PLAIN=

# Optional: override where JSON content lives (default: ./data)
# DATA_DIR=

# Optional: where extracted SCORM packages live (default: ./scorm-packages)
# SCORM_PACKAGES_PATH=

# Contact form (set these in Vercel env vars for production email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=
# SMTP_FROM=
